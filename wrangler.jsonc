{
  // Cloudflare Worker with static assets: dist/ (built by scripts/build-site.mjs) is served as it is, and only /api/* and
  // /admin/* run the small script in worker/ (player feedback, docs/FEEDBACK.md). `npx wrangler deploy` reads this.
  // See docs/DEPLOY.md.
  "name": "nexus",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  // The site is served from playnexus.dev (attached in the dashboard), so no workers.dev address or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/admin/*"]
  }
  // Feedback storage. Create the database once (docs/FEEDBACK.md), then replace this comment with:
  // ,"d1_databases": [{ "binding": "FEEDBACK_DB", "database_name": "nexus-feedback", "database_id": "<id from the dashboard>" }]
  // Until then the feedback route answers 503 and players' notes wait in their browser.
}
